{
  "private": true,
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix back-end run dev\" \"npm --prefix front-end start\"",
    "build": "npm --prefix front-end run build",
    "build:front": "npm --prefix front-end run build",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "db:setup": "npm --prefix back-end run db:setup",
    "db:export": "npm --prefix back-end run db:export",
    "db:sync-cloud": "npm --prefix back-end run db:sync-cloud"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "mysql2": "^3.17.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^8.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
