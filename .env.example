# ─────────────────────────────────────
# Golden Dragon Estate Platform - Environment Variables
# ─────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────

# Server
PORT=5000
SESSION_SECRET=replace_with_secure_random_value
JWT_SECRET=replace_with_secure_random_value

# Database (local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=golden_dragon_corp

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=goldendragone23@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Golden Dragon Estate Corporation <goldendragone23@gmail.com>
